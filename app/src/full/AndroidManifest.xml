<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Beat-reactive wave (PLAN.md N.5e): android.media.audiofx.Visualizer on the output mix needs
         both. Nothing is recorded, stored or sent; asked for only after an in-app explanation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Beat haptics (opt-in, Full only): a short vibration on each detected beat. Normal-level permission:
         no prompt, granted at install. Not declared by the standalone or vibes editions. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <!-- FULL EDITION ONLY. Exists so the user can grant notification access, which authorizes
             reading other apps' media sessions (PLAN.md N). The service ignores all notifications.
             Google Play Protect blocks sideloaded installs of apps declaring this in some markets
             (India, Singapore, Thailand, Brazil): the standalone edition omits it. -->
        <service
            android:name="dev.fitnesstimer.nowplaying.NowPlayingListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
